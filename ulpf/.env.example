# ── Groq API Configuration ─────────────────────────────────────────────────────
# Get your free API key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Model to use. Recommended options:
#   openai/gpt-oss-20b       (recommended default)
#   openai/gpt-oss-120b      (more capable, higher latency)
#   qwen/qwen3.6-27b         (alternative capable model)
GROQ_MODEL=openai/gpt-oss-20b

# ── AI Mapping Behaviour ───────────────────────────────────────────────────────
# Set to "false" to disable AI assistance entirely (pipeline still works locally)
AI_MAPPING_ENABLED=true

# AI is only called when local semantic mapper confidence is BELOW this threshold
# Range: 0.0 – 1.0  |  Default: 0.75
AI_MAPPING_THRESHOLD=0.75

# HTTP timeout in seconds for Groq API requests
AI_REQUEST_TIMEOUT=30

# ── Database Configuration ──────────────────────────────────────────────────────
# PostgreSQL connection string for ULPF persistence
DATABASE_URL=postgresql+psycopg://ulpf_user:password@localhost:5432/ulpf
